{
  "name": "legendary-memory-hub",
  "version": "0.2.0",
  "private": true,
  "description": "The memory hub: shared memory for ChatGPT, Claude and other MCP clients. Runs locally with no account, or on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply DB --remote",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.local.json",
    "test": "vitest run",
    "e2e": "node test/e2e.mjs",
    "build:local": "esbuild src/local/cli.ts --bundle --platform=node --target=node22 --format=esm --loader:.sql=text --external:node:sqlite --outfile=dist/legendary-memory.mjs",
    "local": "npm run build:local && node dist/legendary-memory.mjs serve",
    "test:local": "npm run build:local && node test/local.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "bin": {
    "legendary-memory": "dist/legendary-memory.mjs"
  },
  "engines": {
    "node": ">=22.5"
  }
}
